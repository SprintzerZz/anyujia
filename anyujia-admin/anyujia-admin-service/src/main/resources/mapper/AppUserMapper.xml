<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.anyujia.anyujiaadminservice.user.mapper.AppUserMapper">

    <!-- C 端用户基础查询字段。 -->
    <sql id="AppUserColumns">
        id,
        open_id,
        phone_number,
        nickname,
        avatar_url,
        gender,
        status,
        created_at,
        updated_at
    </sql>

    <!-- C 端用户列表查询条件。 -->
    <sql id="AppUserListWhere">
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="openId != null and openId != ''">
                and open_id = #{openId}
            </if>
            <if test="phoneNumber != null and phoneNumber != ''">
                and phone_number = #{phoneNumber}
            </if>
            <if test="nickname != null and nickname != ''">
                and nickname like concat(#{nickname}, '%')
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
        </where>
    </sql>

    <!-- 根据 openId 查询 C 端用户。 -->
    <select id="selectByOpenId" resultType="com.anyujia.anyujiaadminservice.user.domain.entity.AppUser">
        select
        <include refid="AppUserColumns"/>
        from app_user
        where open_id = #{openId}
        limit 1
    </select>

    <!-- 根据手机号查询 C 端用户。 -->
    <select id="selectByPhoneNumber" resultType="com.anyujia.anyujiaadminservice.user.domain.entity.AppUser">
        select
        <include refid="AppUserColumns"/>
        from app_user
        where phone_number = #{phoneNumber}
        limit 1
    </select>

    <!-- 查询符合条件的 C 端用户总数。 -->
    <select id="selectCount" resultType="java.lang.Long">
        select count(1)
        from app_user
        <include refid="AppUserListWhere"/>
    </select>

    <!-- 分页查询 C 端用户。 -->
    <select id="selectPage" resultType="com.anyujia.anyujiaadminservice.user.domain.entity.AppUser">
        <bind name="offset" value="(pageIndex - 1) * pageSize"/>
        select
        <include refid="AppUserColumns"/>
        from app_user
        <include refid="AppUserListWhere"/>
        order by id desc
        limit #{pageSize} offset #{offset}
    </select>
</mapper>
